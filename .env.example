# FleetMind AI Environment Configuration
DATABASE_URL=sqlite:///./fleetmind.db

# Ollama / GenAI configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.2
OLLAMA_ENABLED=true
VECTOR_DB_PATH=./rag/chroma_db
RAG_USE_CHROMA=true

# JWT Authentication
JWT_SECRET_KEY=fleetmind-super-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Default Risk Weights (must sum to 1.0)
WEIGHT_MAINTENANCE=0.40
WEIGHT_FUEL=0.30
WEIGHT_DELAY=0.30
